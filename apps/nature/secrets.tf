# jayeon-was 의 JWT 서명키 2개.
#
# ── 🔴 왜 Terraform 이 값을 만드는가 ─────────────────────────────────────────
#
# 아무도 이 값을 알 필요가 없다. 서명하고 검증하는 것은 WAS 뿐이고, 사람이 볼 이유가 없다.
#
# 사람이 올리는 방식(manual = true)으로 두면 실패 모양이 나쁘다. 첫 배포 전에 그 단계를
# 빼먹으면 **컨테이너가 기동조차 못 한다** — JWT_SECRET 이 없으면 WAS 가 기동을 거부하므로
# 리비전이 Ready 가 되지 않고, 배포는 "이미지는 멀쩡한데 왜 안 뜨는지" 모르는 상태로 멈춘다.
# Terraform 이 만들면 시크릿과 그 첫 버전이 서비스보다 먼저 존재하는 것이 구조로 보장된다.
#
# ── 🔴 두 값이 같으면 WAS 가 기동을 거부한다 ─────────────────────────────────
#
# 이 모듈은 시크릿마다 별도의 random_password 리소스로 값을 만든다. 즉 **서로 다른 시크릿
# 리소스 2개**이고, 값이 겹칠 확률은 사실상 0이라 그 조건에 자동으로 걸리지 않는다.
#
# 그래도 왜 거부하는지는 알고 있어야 한다 — 하나의 시크릿을 두 환경변수에 연결하는 실수
# (run.tf 에서 두 secret_env 가 같은 secret_ids 를 가리키는 것)를 하면 그 순간 배포가
# 기동 실패로 떨어진다. 이유: 키가 같으면 어드민 토큰이 **사용자** 인증 미들웨어의 서명
# 검증을 통과하는데, 그 미들웨어는 토큰의 `sub` 를 그대로 userId 로 넣는다. 어드민 토큰의
# `sub` 는 문자열이 아니라 객체라서, 클레임 모양이 조금만 달라지면 어드민 토큰 하나로 남의
# 사용자 API 를 호출할 수 있게 된다. WAS 는 그 상태로 뜨는 것을 거부하는 쪽을 골랐다.
#
# ── 🔴 값이 Terraform state 에 평문으로 들어간다 ─────────────────────────────
#
# random_password 의 결과는 state 에 그대로 저장된다. 이걸 피할 방법은 없다(Terraform 이
# 값을 만들면서 다음 plan 에 같은 값을 재현하려면 저장해야 한다).
#
# 그래서 state 버킷이 방어선이다. `redhead-kr-tfstate` 는 shared/ 가
# `public_access_prevention = enforced` + uniform bucket-level access 로 만든다 —
# 실수로 공개 ACL 을 붙일 수 없고, 접근은 IAM 하나로만 갈린다. 버킷 IAM 을 넓히는 것은
# 이 서명키를 넓히는 것과 같다.
#
# 같은 이유로 **생성된 값을 루트 output 으로 내보내지 않는다**(§outputs.tf).
#
# ── 키 교체(rotate) 절차 ────────────────────────────────────────────────────
#
# 시크릿에 새 버전을 올리고(`gcloud secrets versions add`) Cloud Run 리비전을 새로 띄운다.
# 환경변수가 `version = "latest"` 로 붙어 있어도 **이미 뜬 인스턴스는 기동 시점의 값을 들고
# 있다** — 리비전을 새로 만들지 않으면 옛 키가 계속 쓰인다.
#
# 대가: 그 키로 서명된 기존 토큰이 전부 무효가 된다. JWT_SECRET 을 갈면 전 사용자가 다시
# 로그인해야 하고, ADMIN_JWT_SECRET 을 갈면 어드민이 다시 로그인하면 그만이다.
#
# random_length 를 바꾸는 것도 교체다 — random_password 가 재생성되면서 값이 바뀐다.
# "길이를 조금 늘려 볼까" 로 전 사용자를 로그아웃시키지 말 것.
module "secrets" {
  source = "../../modules/secrets"

  project_id = var.project_id

  secrets = {
    # 사용자 액세스/리프레시 토큰의 서명키.
    #
    # 🔴 미설정이면 WAS 가 **기동하지 않는다.** 그래서 이 시크릿이 없는 상태로는 배포 자체가
    # 성립하지 않고, 조용한 실패가 없다.
    JWT_SECRET = { random_length = 32 }

    # 어드민 토큰의 서명키. **위와 반드시 다른 시크릿 리소스다**(상단 주석).
    #
    # ⚠️ 비어 있으면 WAS 는 기동한다 — 어드민 라우트를 하나도 등록하지 않고 경고만 남긴다.
    # 어드민 API 가 전부 404 이고 기동·헬스체크·응답 코드는 정상이라 알람이 울리지 않는다.
    # 어드민 화면은 멀쩡히 뜨고 로그인 버튼만 404 를 받는다. 이 모듈이 값을 만들어 넣으므로
    # 그 상태가 되지는 않지만, 연결을 빼면(run.tf 의 secret_env 에서 지우면) 그렇게 된다.
    ADMIN_JWT_SECRET = { random_length = 32 }
  }

  # 🔴 시크릿 단위로만 준다. 프로젝트 레벨 secretAccessor 는 과도하고, 우산 프로젝트에서는
  # 다른 앱의 시크릿까지 열게 된다.
  #
  # 🔴 jayeon-app 런타임에는 주지 않는다. 정적 파일을 내주는 nginx 컨테이너가 서명키를 읽을
  # 이유가 없다. accessor_members 는 이 모듈의 **모든** 시크릿에 한꺼번에 걸리므로, 여기에
  # 계정을 하나 더 넣는 것은 두 서명키를 동시에 여는 일이다.
  accessor_members = [module.was_service_account.member]
}
